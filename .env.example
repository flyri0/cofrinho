# Copy this file to .env (already gitignored) and fill in your own values.

# Google Drive backup (see src/lib/googleDrive/auth.ts for full setup steps):
#   1. In Google Cloud Console, enable the Google Drive API for your project.
#   2. Create an OAuth 2.0 Client ID of type "Desktop app" — NOT "Web
#      application" (which rejects a custom-scheme redirect URI like
#      `cofrinho://` with "must contain a domain") and NOT Android/iOS
#      (which use a fixed redirect scheme this app can't use).
#   3. No redirect URI needs to be registered for a "Desktop app" client.
#   4. Paste the client ID below.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
