# Copy this file to .env (already gitignored) and fill in your own values.

# Google Drive backup (see src/lib/googleDrive/auth.ts for full setup steps):
#   1. In Google Cloud Console, enable the Google Drive API for your project.
#   2. Create an OAuth 2.0 Client ID of type "Web application" (not
#      Android/iOS — those use a fixed redirect scheme this app can't use).
#   3. Add this app's redirect URI to its "Authorized redirect URIs".
#      On a custom dev client this is `cofrinho://`.
#   4. Paste the client ID below.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
